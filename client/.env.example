# Optional absolute HTTP(S) API origin or full API URL for development and
# same-site production deployments with a separately hosted frontend.
# Credentials, query strings, fragments, and production HTTP URLs are rejected.
# The client removes trailing slashes and ensures exactly one terminal /api.
# Use an API origin on the same site as the frontend; arbitrary cross-site
# cookie authentication is not supported.
# VITE_API_URL=https://api.example.com
# VITE_API_URL=https://api.example.com/api

# When omitted in development, the client uses the current browser hostname
# on port 4000. When omitted in production, it uses the same-origin /api path.

# Optional public health-check URL that the browser loads while the API is
# waking. Production defaults to https://replog-tracker.onrender.com/health.
# This is not a secret; never include credentials, tokens, or private URLs.
# VITE_API_WAKE_URL=https://replog-tracker.onrender.com/health

# VITE_* values are embedded in the browser bundle. Never put server secrets,
# database credentials, or private tokens in this file or any Vite variable.
