# Optional API origin or full API URL for both development and production.
# The client removes trailing slashes and ensures exactly one terminal /api.
# VITE_API_URL=https://api.example.com
# VITE_API_URL=https://api.example.com/api

# When omitted in development, the client uses the current browser hostname
# on port 4000. When omitted in production, it uses the same-origin /api path.

# VITE_* values are embedded in the browser bundle. Never put server secrets,
# database credentials, or private tokens in this file or any Vite variable.
