// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

enum ExerciseCategory {
  CHEST
  BACK
  SHOULDERS
  LEGS
  ARMS
  CORE
}

enum SetKind {
  WARMUP
  NORMAL
  DROP
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  username      String
  passwordHash  String?
  googleId      String?    @unique
  avatarInitial String
  createdAt     DateTime   @default(now())
  exercises     Exercise[]
  programs      Program[]
  sessions      Session[]
}

model Exercise {
  id               String            @id @default(cuid())
  name             String
  category         ExerciseCategory
  ownerId          String?
  createdAt        DateTime          @default(now())
  owner            User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  dayExercises     DayExercise[]
  sessionExercises SessionExercise[]

  @@index([ownerId])
  @@index([category])
}

model Program {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  days      Day[]

  @@index([ownerId])
}

model Day {
  id           String       @id @default(cuid())
  programId    String
  name         String
  badgeColor   String
  order        Int
  program      Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayExercises DayExercise[]
  sessions     Session[]

  @@unique([programId, order])
  @@index([programId])
}

model DayExercise {
  id         String   @id @default(cuid())
  dayId      String
  exerciseId String
  order      Int
  day        Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([dayId, order])
  @@index([exerciseId])
}

model Session {
  id                 String            @id @default(cuid())
  userId             String
  dayId              String?
  dayNameSnapshot    String
  badgeColorSnapshot String
  startedAt          DateTime          @default(now())
  endedAt            DateTime?
  durationSec        Int?
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  day                Day?              @relation(fields: [dayId], references: [id], onDelete: SetNull)
  sessionExercises   SessionExercise[]

  @@index([dayId])
  @@index([userId, startedAt])
}

model SessionExercise {
  id         String   @id @default(cuid())
  sessionId  String
  exerciseId String
  nameSnapshot String
  order      Int
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  setLogs    SetLog[]

  @@unique([sessionId, order])
  @@index([exerciseId])
}

model SetLog {
  id                String          @id @default(cuid())
  sessionExerciseId String
  kind              SetKind         @default(NORMAL)
  weightKg          Float
  reps              Int
  order             Int
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@unique([sessionExerciseId, order])
}
