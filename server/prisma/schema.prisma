// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SetKind {
  WARMUP
  NORMAL
  DROP
}

model User {
  id                     String     @id @default(cuid())
  email                  String     @unique
  username               String
  passwordHash           String?
  googleId               String?    @unique
  avatarInitial          String
  authVersion            Int        @default(0)
  passwordResetTokenHash String?    @unique
  passwordResetExpiresAt DateTime?
  createdAt              DateTime   @default(now())
  exercises              Exercise[]
  programs               Program[]
  sessions               Session[]
  categories             ExerciseCategory[]
  categoryLabels         UserCategoryLabel[]
}

model ExerciseCategory {
  id             String     @id @default(cuid())
  displayName    String
  normalizedName String
  ownerId        String?
  builtInKey     String?    @unique
  displayOrder   Int
  owner          User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  exercises      Exercise[]
  userLabels     UserCategoryLabel[]

  @@unique([ownerId, normalizedName])
  @@index([ownerId, displayOrder])
}

model UserCategoryLabel {
  id             String           @id @default(cuid())
  userId         String
  categoryId     String
  displayName    String
  normalizedName String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       ExerciseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@unique([userId, normalizedName])
  @@index([categoryId])
}

model Exercise {
  id               String            @id @default(cuid())
  name             String
  categoryId       String
  ownerId          String?
  createdAt        DateTime          @default(now())
  owner            User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  category         ExerciseCategory  @relation(fields: [categoryId], references: [id])
  dayExercises     DayExercise[]
  sessionExercises SessionExercise[]

  @@index([ownerId])
  @@index([categoryId])
}

model Program {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  nameKey   String
  activeKey String?
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  days      Day[]
  sessions  Session[]

  @@index([ownerId])
  @@unique([ownerId, nameKey])
  @@unique([ownerId, activeKey])
}

model Day {
  id           String       @id @default(cuid())
  programId    String
  name         String
  badgeColor   String
  order        Int
  program      Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  dayExercises DayExercise[]
  sessions     Session[]

  @@unique([programId, order])
  @@index([programId])
}

model DayExercise {
  id         String   @id @default(cuid())
  dayId      String
  exerciseId String
  order      Int
  day        Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([dayId, order])
  @@index([exerciseId])
}

model Session {
  id                  String            @id @default(cuid())
  userId              String
  programId           String?
  programNameSnapshot String?
  dayId               String?
  dayNameSnapshot     String
  badgeColorSnapshot  String
  startedAt           DateTime          @default(now())
  endedAt             DateTime?
  durationSec         Int?
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  program             Program?          @relation(fields: [programId], references: [id], onDelete: SetNull)
  day                 Day?              @relation(fields: [dayId], references: [id], onDelete: SetNull)
  sessionExercises    SessionExercise[]

  @@index([dayId])
  @@index([programId])
  @@index([userId, startedAt])
}

model SessionExercise {
  id         String   @id @default(cuid())
  sessionId  String
  exerciseId String
  nameSnapshot String
  order      Int
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  setLogs    SetLog[]

  @@unique([sessionId, order])
  @@index([exerciseId])
}

model SetLog {
  id                String          @id @default(cuid())
  sessionExerciseId String
  parentSetId       String?
  kind              SetKind         @default(NORMAL)
  notes             String?
  weightKg          Float
  reps              Int
  order             Int
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  parentSet         SetLog?         @relation("DropSetParent", fields: [parentSetId], references: [id], onDelete: Cascade)
  dropSets          SetLog[]        @relation("DropSetParent")

  @@unique([sessionExerciseId, order])
  @@index([parentSetId])
}
