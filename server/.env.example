# Local development database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/replog?schema=public
# npm test uses a separate database and creates a temporary schema in it.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/replog_test?schema=public
JWT_SECRET=replace-with-at-least-16-characters
CLIENT_URL=http://localhost:5173
# Used for Google OAuth redirects and password-reset links. Normal local/LAN
# API requests also accept the browser's localhost or private LAN origin.
# Optional Google OAuth configuration:
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# Optional password-reset delivery:
# RESEND_API_KEY=re_your_api_key
EMAIL_FROM=RepLog <onboarding@resend.dev>
PORT=4000

# Resend's onboarding sender can only send to the email address that owns the
# Resend account. Replace EMAIL_FROM after verifying a production domain.

# For phone testing on the same Wi-Fi, no environment change is required.
